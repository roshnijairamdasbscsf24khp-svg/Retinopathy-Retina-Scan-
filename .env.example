# =====================================================================
# RetinaAI — Diabetic Retinopathy Detection & Analysis System
# Environment Configuration Template
# =====================================================================
# Copy this file to .env and adjust values as needed.
# All settings have safe built-in defaults if left unset.

# Workspace root directory path
RETINOPATHY_WORKSPACE=D:\Retinopathy detection

# Server Host and Port
RETINOPATHY_HOST=127.0.0.1
RETINOPATHY_PORT=8000

# Computational Device: "auto" (detects CUDA, falls back to CPU), "cpu", or "cuda"
RETINOPATHY_DEVICE=auto

# Clinical Diagnostic Confidence & Quality Thresholds
RETINOPATHY_LOW_CONF_THRESHOLD=0.60
RETINOPATHY_QUALITY_THRESHOLD=0.50
